# Fuzzing runtime artifacts.
# The cycle_130 T3 workstream commits per-surface logs and stats.json as
# durable adversarial evidence; the older T2 top-level stats.json and logs/
# directory are still regenerated by run_all.sh on every run.

# Top-level T2 stats (regenerated by run_all.sh): keep ignored.
/stats.json
/logs/

# Top-level T3 AGGREGATE_STATS.json: explicitly allow.
/!AGGREGATE_STATS.json

# Per-surface T3 deliverables: explicitly allow.
/!crc_main/
/!engine_streaming/
/!table_integrity/
/!cli_args/
/!type_errors/
/!cross_cycle_oracle/

# Crash artifacts from libFuzzer (transient, regenerated every run).
crash-*

# Fuzzer venv.
.venv-fuzz/

# libFuzzer / atheris transient artefacts.
*.profdata
*.profraw

# libFuzzer-generated coverage corpus (sha1-named files in corpus/seed/ that
# accumulate after each run); keep our explicit seed_*.bin names but ignore
# the auto-generated ones (40-char hex names).
corpus/seed/????????????????????????????????????????
